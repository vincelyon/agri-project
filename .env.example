# PostgreSQL connection string (server-side only; never prefix with NEXT_PUBLIC_)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/agri_stock?schema=public"

# Secret used to sign session cookies. Generate with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-string"

# Used by `npm run db:seed` to create the first administrator
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"
SEED_ADMIN_NAME="Shop Administrator"

# Set to "true" to also load demo categories, products and suppliers when seeding
SEED_DEMO_DATA="false"

# Integration tests use a separate database (its name must contain "test")
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/agri_stock_test?schema=public"
